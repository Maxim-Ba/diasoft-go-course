FROM golang:1.25 as build

ENV BIN_FILE /opt/calendar/calendar-storer
ENV CODE_DIR /go/src/

WORKDIR ${CODE_DIR}

COPY go.mod .
COPY go.sum .
RUN go mod download

COPY . ${CODE_DIR}

ARG LDFLAGS
RUN CGO_ENABLED=0 go build \
        -ldflags "$LDFLAGS" \
        -o ${BIN_FILE} cmd/calendar_storer/*

FROM alpine:3.19

LABEL SERVICE="calendar-storer"

ENV BIN_FILE "/opt/calendar/calendar-storer"
COPY --from=build ${BIN_FILE} ${BIN_FILE}

ENV CONFIG_FILE /etc/calendar/storer_config.yaml
COPY ./configs/storer_config.yaml ${CONFIG_FILE}

CMD ${BIN_FILE} -config ${CONFIG_FILE}
